---
import { ArrowUpRight } from '@lucide/astro'; import SectionTitle from './SectionTitle.astro'; import Icon from './Icon.astro'; import { projects } from '../data/projects';
---
<section id="proyectos" class="section section-muted" aria-labelledby="projects-title"><div class="container"><SectionTitle eyebrow="04 — Proyectos" title="Proyectos destacados." description="Actualmente se muestran estructuras de demostración; serán sustituidas por proyectos reales verificables." /><div class="project-grid" id="projects-title">{projects.map((project, index) => <article class="project-card reveal"><div class="project-visual" aria-hidden="true"><span>0{index + 1}</span><div></div><div></div><div></div></div><div class="project-body"><div class="project-topline"><span class="badge">{project.status}</span></div><h3>{project.name}</h3><p>{project.description}</p><ul>{project.features.map((feature) => <li>{feature}</li>)}</ul><div class="project-footer"><div class="project-icons" aria-label={`Tecnologías: ${project.technologies.join(', ')}`}>{project.technologies.map((tech) => <Icon name={tech.toLowerCase().replaceAll(' ', '')} label={tech} />)}</div>{project.github && <a href={project.github} target="_blank" rel="noreferrer" aria-label={`Repositorio de ${project.name}`}><Icon name="github" label="GitHub" /></a>}{project.demo && <a href={project.demo} target="_blank" rel="noreferrer" aria-label={`Demo de ${project.name}`}><ArrowUpRight size={19} /></a>}</div></div></article>)}</div></div></section>
